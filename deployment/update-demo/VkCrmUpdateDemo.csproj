<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VK-CRM-Update-Demo</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationIcon>../installer/VK-CRM.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../public/assets/branding/vk-software-logo.png" LogicalName="brand.png" />
    <EmbeddedResource Include="../installer/VK-CRM.ico" LogicalName="brand.ico" />
  </ItemGroup>
</Project>
